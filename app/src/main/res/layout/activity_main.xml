<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      ÜST BANT — tek bakışta okunacak şekilde kuruldu:
      büyük simge (ne yapacağım) + büyük rakam (ne kadar kaldı) + şerit (hangi şerit).
      Hız/varış gibi ikincil bilgiler bilerek alt kartta, burada değil.
    -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:elevation="10dp"
        android:background="@drawable/card"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/maneuver_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_straight"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/maneuver_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="—" />

                <TextView
                    android:id="@+id/maneuver_road"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Yaklaşma çubuğu: rakamı okumadan da mesafe hissi verir -->
        <View
            android:id="@+id/approach_bar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bar" />

        <!-- Şerit rehberliği: yalnızca dönüş/sapak yaklaşırken görünür -->
        <com.jlr.jacobmaps.LaneView
            android:id="@+id/lanes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- SAĞ: yuvarlak düğmeler -->
    <LinearLayout
        android:id="@+id/side_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btn_theme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="20sp"
            android:elevation="8dp"
            android:background="@drawable/circle"
            android:text="◐" />

        <TextView
            android:id="@+id/btn_recenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="20sp"
            android:elevation="8dp"
            android:background="@drawable/circle"
            android:text="◎" />

        <TextView
            android:id="@+id/btn_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="12sp"
            android:elevation="8dp"
            android:background="@drawable/circle"
            android:text="20km" />

        <TextView
            android:id="@+id/btn_offline"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="12sp"
            android:elevation="8dp"
            android:background="@drawable/circle"
            android:text="indir" />
    </LinearLayout>

    <!-- ALT: bilgi kartı ve eylem -->
    <LinearLayout
        android:id="@+id/bottom_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="10dp"
        android:background="@drawable/card">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="JacobMaps" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:text="Haritaya uzun bas: hedef seç" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_primary"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary"
                android:text="Enez'e rota kur" />

            <TextView
                android:id="@+id/btn_secondary"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:textSize="16sp"
                android:background="@drawable/btn_secondary"
                android:text="Sim"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
